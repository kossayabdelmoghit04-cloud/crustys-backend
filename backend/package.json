{
  "name": "crustys-express-backend",
  "version": "1.0.0",
  "description": "Backend API for Crusty's Express - Premium Canadian Street Food",
  "main": "dist/server.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test:unit": "jest src/tests/unit",
    "test:coverage": "jest src/tests/unit --coverage",
    "test:watch": "jest src/tests/unit --watch",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:security": "jest --config jest.security.config.js --runInBand",
    "test": "jest src/tests/unit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@prisma/client": "^5.14.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.77.2",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "geoip-lite": "^1.4.10",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nanoid": "^3.3.12",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "rate-limit-redis": "^5.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "resend": "^6.12.3",
    "sharp": "^0.34.5",
    "streamifier": "^0.1.1",
    "stripe": "^22.1.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "useragent": "^2.3.0",
    "winston": "^3.13.0",
    "xss": "^1.0.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.12.12",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/streamifier": "^0.1.2",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.0",
    "prisma": "^5.14.0",
    "rimraf": "^5.0.7",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
