generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  admins      Admin[]

  @@map("roles")
}

model Admin {
  id            String              @id @default(uuid())
  fullName      String              @map("full_name")
  email         String              @unique
  password      String
  roleId        String              @map("role_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  role          Role                @relation(fields: [roleId], references: [id])
  notifications AdminNotification[]

  @@map("admins")
}

model User {
  id                   String        @id @default(cuid())
  email                String        @unique
  password             String
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  avatar               String?
  fullName             String        @default("") @map("full_name")
  isVerified           Boolean       @default(false) @map("is_verified")
  phone                String?
  deletedAt            DateTime?     @map("deleted_at")
  firstName            String        @map("first_name")
  isActive             Boolean       @default(true) @map("is_active")
  lastName             String        @map("last_name")
  passwordResetExpires DateTime?     @map("password_reset_expires")
  passwordResetToken   String?       @map("password_reset_token")
  refreshToken         String?       @map("refresh_token")
  role                 UserRole      @default(CUSTOMER)
  orders               Order[]
  reservations         Reservation[]

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  description String?
  image       String?
  isActive    Boolean   @default(true) @map("is_active")
  slug        String    @unique
  products    Product[]

  @@map("categories")
}

model Product {
  id            String         @id @default(uuid())
  name          String
  description   String?
  price         Float
  image         String?
  categoryId    String         @map("category_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  calories      Int?
  discountPrice Float?         @map("discount_price")
  isAvailable   Boolean        @default(true) @map("is_available")
  isFeatured    Boolean        @default(false) @map("is_featured")
  slug          String         @unique
  stockQuantity       Int            @default(0) @map("stock_quantity")
  lowStockThreshold   Int            @default(5) @map("low_stock_threshold")
  stockAlertEnabled   Boolean        @default(true) @map("stock_alert_enabled")
  lastLowStockAlertAt DateTime?      @map("last_low_stock_alert_at")
  orderItems          OrderItem[]
  images              ProductImage[]
  category            Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  imageUrl  String   @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Order {
  id              String      @id @default(uuid())
  userId          String?     @map("user_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  customerAddress String?     @map("customer_address")
  customerPhone   String      @map("customer_phone")
  deliveryType    String      @map("delivery_type")
  notes           String?
  orderNumber     String      @unique @map("order_number")
  orderStatus     OrderStatus @default(PENDING) @map("order_status")
  paymentStatus   String      @map("payment_status")
  totalPrice      Float       @map("total_price")
  items           OrderItem[]
  user            User?       @relation(fields: [userId], references: [id])
  payments        Payment[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int
  subtotal  Float
  unitPrice Float   @map("unit_price")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @map("order_id")
  transactionId String?       @map("transaction_id")
  amount        Float
  paidAt        DateTime      @default(now()) @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  currency      String        @default("CAD")
  paymentMethod PaymentMethod @map("payment_method")
  paymentStatus PaymentStatus @map("payment_status")
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Reservation {
  id              String            @id @default(uuid())
  userId          String?           @map("user_id")
  status          ReservationStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  customerEmail   String?
  customerName    String
  customerPhone   String
  guestsCount     Int
  notes           String?
  reservationDate DateTime
  reservationTime String
  updatedAt       DateTime          @updatedAt
  user            User?             @relation(fields: [userId], references: [id])

  @@index([reservationDate])
  @@map("reservations")
}

model ActivityLog {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  userEmail     String?  @map("user_email")
  role          String?
  action        String
  entity        String?
  entityId      String?  @map("entity_id")
  oldValue      Json?    @map("old_value")
  newValue      Json?    @map("new_value")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  sentryEventId String?  @map("sentry_event_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@map("activity_logs")
}

model Testimonial {
  id           String   @id @default(cuid())
  customerName String
  message      String
  rating       Int
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Contact {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name")
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contacts")
}

model Gallery {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String   @map("image_url")
  category  String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("gallery")
}

model SiteContent {
  id         String   @id @default(uuid())
  sectionKey String   @unique @map("section_key")
  title      String
  content    String
  imageUrl   String?  @map("image_url")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("site_contents")
}

model MediaMetadata {
  id             String   @id @default(uuid())
  originalName   String   @map("original_name")
  format         String
  size           Int
  width          Int
  height         Int
  urls           Json
  variants       Json
  uploadDuration Int      @map("upload_duration")
  totalDuration  Int      @map("total_duration")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("media_metadata")
}

model UploadSession {
  id          String   @id @default(uuid())
  fingerprint String
  ipAddress   String   @map("ip_address")
  status      String
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("upload_sessions")
}

model UploadVersion {
  id          String   @id @default(uuid())
  resourceId  String   @map("resource_id")
  version     Int      @default(1)
  originalUrl String   @map("original_url")
  activeUrl   String   @map("active_url")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("upload_versions")
}

model FailedUpload {
  id           String   @id @default(uuid())
  jobId        String   @unique @map("job_id")
  originalName String   @map("original_name")
  prefix       String
  errorReason  String   @map("error_reason")
  attempts     Int      @default(0)
  stackTrace   String?  @map("stack_trace")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("failed_uploads")
}

model MediaProcessingLog {
  id        String   @id @default(uuid())
  jobId     String   @map("job_id")
  fileName  String   @map("file_name")
  step      String
  duration  Int
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("media_processing_logs")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DELIVERED
  CANCELLED
  DELIVERING
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  CASH
  STRIPE
}

enum UserRole {
  ADMIN
  CUSTOMER
}

model AdminNotification {
  id          String   @id @default(cuid())
  title       String
  message     String

  type        NotificationType

  isRead      Boolean  @default(false)

  metadata    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  adminId     String?

  admin       Admin? @relation(fields: [adminId], references: [id])

  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@map("admin_notifications")
}

enum NotificationType {
  ORDER_CREATED
  ORDER_PAID
  ORDER_CANCELLED
  ORDER_REFUNDED

  RESERVATION_CREATED
  RESERVATION_CANCELLED

  CONTACT_RECEIVED

  TESTIMONIAL_CREATED

  LOW_STOCK
  OUT_OF_STOCK

  SECURITY_ALERT

  ADMIN_CREATED
  ROLE_CHANGED
  USER_DELETED
}

