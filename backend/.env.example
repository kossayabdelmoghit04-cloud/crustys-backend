# Server configuration
PORT=5000
NODE_ENV=development # Set to "production" in production environments

# Database configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# Security (JWT)
# Generate secure secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-jwt-access-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-at-least-32-chars-long"
JWT_REFRESH_EXPIRES_IN="7d"

# Optional JWT override secrets (defaults to JWT_SECRET and JWT_REFRESH_SECRET)
ACCESS_TOKEN_SECRET="optional-override-access-secret"
REFRESH_TOKEN_SECRET="optional-override-refresh-secret"

# CORS configuration
CORS_ORIGIN="http://localhost:3000" # Set to production frontend domain in production

# Redis Configuration (BullMQ for image processing and emails)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# Stripe Configuration (Payment Processing)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email Configuration (SaaS Core)
MAIL_PROVIDER="mailtrap" # Options: "mailtrap" or "resend"
MAIL_FROM="noreply@crustys.com"

# Resend Settings (if MAIL_PROVIDER=resend)
RESEND_API_KEY="re_..."

# Mailtrap Settings (if MAIL_PROVIDER=mailtrap)
MAILTRAP_HOST="sandbox.smtp.mailtrap.io"
MAILTRAP_PORT=2525
MAILTRAP_USER="your-mailtrap-user"
MAILTRAP_PASS="your-mailtrap-password"

# Cloudinary Configuration (Media Storage)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
